{
  "purpose": "Paired receiver-noise intervention with fixed client partitions",
  "seeds": [62001, 62002, 62003],
  "methods": ["channel", "data", "delete_joint"],
  "new_receiver_noise_variances": {"no_noise": 0.0, "nominal0dB": 1.0},
  "reused_receiver_noise_variance": {"nominal20dB": 0.01},
  "clients": 20,
  "shards": 4,
  "source_rounds": 160,
  "deletion_rounds": 160,
  "deletion_clients": "each of all 20 clients, separately",
  "local_steps_per_round": 2,
  "batch_size": 64,
  "learning_rate": 0.05,
  "momentum": 0,
  "update_l2_clip": 1.0,
  "maximum_average_symbol_power": 1.0,
  "repeats": 1,
  "early_stopping": false,
  "partition_reoptimization": false,
  "common_random_noise_direction": true,
  "within_method_fixed": ["data", "group membership", "group sizes", "initial weights", "minibatches", "channel trajectory", "round counts", "radio-use count", "power bound"],
  "between_method_not_fixed": ["group membership", "group sizes", "within-shard data mix", "per-deletion local computation"],
  "guarantee_scope": "Fixed public routing conditional model retraining; not metadata erasure or cryptographic privacy"
}
